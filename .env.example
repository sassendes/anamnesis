# API connects as the least-privileged app role so RLS is enforced.
ANAMNESIS_DATABASE_URL=postgres://anamnesis_app:root@localhost:5432/anamnesis?sslmode=disable
# Migrations and admin provisioning need the superuser (creates roles/extensions,
# and provisioning resolves hospitals across tenants). Use this URL for those:
#   DATABASE_URL=postgres://postgres:root@localhost:5432/anamnesis?sslmode=disable
ANAMNESIS_JWT_SECRET=root
ANAMNESIS_LISTEN_ADDR=0.0.0.0:8080
ANAMNESIS_METRICS_ADDR=0.0.0.0:9090
ANAMNESIS_JWT_TTL_SECONDS=3600
ANAMNESIS_MAX_CONNECTIONS=20
ANAMNESIS_OUTBOX_INTERVAL_MS=2000
ANAMNESIS_NATS_URL=nats://nats:4222
ANAMNESIS_OIDC_ISSUER=
ANAMNESIS_OIDC_CLIENT_ID=
ANAMNESIS_WEBHOOK_URL=
ANAMNESIS_OTEL_ENDPOINT=
POSTGRES_DB=anamnesis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root