#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

MANIFEST=app/Cargo.toml
staged=$(git diff --cached --name-only -- '*.rs' 'Cargo.toml' 'Cargo.lock' || true)
[ -z "$staged" ] && exit 0

echo "pre-commit: fmt"
cargo fmt --manifest-path "$MANIFEST" --all -- --check
echo "pre-commit: clippy"
cargo clippy --manifest-path "$MANIFEST" --all-targets -- -D warnings
echo "pre-commit: test"
cargo test --manifest-path "$MANIFEST" --quiet

echo "pre-commit OK"
exit 0
